# All values are optional: defaults resolve relative to the project root.

# Dataset variant: HI-Small (default), HI-Medium, HI-Large, LI-Small, LI-Medium, LI-Large
AML_DATASET_VARIANT=HI-Small

# Storage locations
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
DUCKDB_PATH=./data/aml.duckdb

# Kaggle credentials — only needed if kagglehub asks you to authenticate
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
